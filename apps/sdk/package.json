{
  "name": "land-governance-platform",
  "version": "1.0.0",
  "description": "Official TypeScript & JavaScript SDK for the National Land Governance Platform (SIH PS 26019)",
  "keywords": [
    "land-governance",
    "dolr",
    "sih",
    "sih-2026",
    "digital-india",
    "gis",
    "cadastre",
    "svamitva",
    "dilrmp",
    "policy-simulation",
    "typescript",
    "sdk"
  ],
  "author": "Land Governance Platform Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ayushjagtap2022/Land-Governance-Platform.git",
    "directory": "apps/sdk"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.2",
    "typescript": "~5.9.3",
    "vitest": "^1.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
