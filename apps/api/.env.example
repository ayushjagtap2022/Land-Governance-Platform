# Land Governance Platform - Environment Variables Template
# Copy this file to .env and replace placeholders with production secrets.

# Neon Serverless PostgreSQL Connection String (pooled connection recommended)
DATABASE_URL="postgresql+asyncpg://neondb_owner:<NEON_PASSWORD>@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# JWT Secret Key (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY="replace_with_a_cryptographically_secure_random_hex_string_32_bytes"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Upstash Redis Connection String (For real-time presence and rate-limiting)
REDIS_URL="rediss://default:<UPSTASH_TOKEN>@sample-region.upstash.io:6379"

# Supabase S3-Compatible Object Storage
S3_ENDPOINT_URL="https://your-project.storage.supabase.co/storage/v1/s3"
S3_REGION="ap-south-1"
S3_ACCESS_KEY="your_supabase_s3_access_key"
S3_SECRET_KEY="your_supabase_s3_secret_key"
S3_BUCKET_NAME="proposals-bucket"

# Google Gemini API Key (For semantic query expansion and multimodal document synthesis)
GEMINI_API_KEY="your_gemini_api_key_here"
